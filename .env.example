# Maple & Pine Command Center — environment configuration
#
# The dashboard runs with zero configuration using realistic mock data.
# To wire up a real source, set its MODE variable to "live". Every source
# is independent — you can flip one to live while leaving the others on
# mock.
#
# IMPORTANT — two kinds of variables below:
#   - VITE_*_MODE  → just a "mock"/"live" flag, not a secret, safe to set
#                    as a client-side Vite env var.
#   - Everything else below the mode line is a real credential. These are
#     deliberately NOT prefixed with VITE_, because Vite bundles every
#     VITE_-prefixed variable straight into the client-side JS — anyone who
#     opens dev tools on a deployed site could read it. Real credentials
#     are only ever read server-side, by the serverless functions under
#     /api/. Set them in your deployment platform's project settings (e.g.
#     Vercel → Project → Settings → Environment Variables), not in a
#     VITE_-prefixed var, and never commit real values to this repo.
#
# Copy this file to .env.local for local `vercel dev` use. Plain `vite dev`
# does not run the /api functions — see README.md.

# ---------------------------------------------------------------------------
# Notion (OmniStack) — primary source of truth for tasks, project/release
# status, and AI-agent activity logs.
# ---------------------------------------------------------------------------
VITE_NOTION_MODE=mock

# Server-side only (read by api/notion-agent-activity.js). Internal
# integration token from https://www.notion.so/my-integrations. Share the
# relevant databases with the integration before this will work.
NOTION_API_KEY=

# Server-side only. Data source id for the "OMNISTACK — Handoff Ledger"
# database — this is what AI Agent Activity reads from today.
NOTION_HANDOFF_LEDGER_DATA_SOURCE_ID=

# Server-side only (read by api/notion-release-calendar.js). Data source id
# for the "Master Release Calendar" database — this is what Release &
# Ritual Calendar reads from today.
NOTION_RELEASE_CALENDAR_DATA_SOURCE_ID=

# Not yet wired to live data — the real workspace's Tasks/Projects
# databases are either ambiguous (multiple candidates) or empty of real
# data right now (see src/lib/data-sources/notion.ts for the full story).
# Reserved for when they get their own proxies:
# NOTION_TASKS_DATA_SOURCE_ID=
# NOTION_PROJECTS_DATA_SOURCE_ID=

# ---------------------------------------------------------------------------
# Google Calendar — today's scheduled events/deadlines.
# Not yet wired to live data — needs a server-side proxy (see README).
# ---------------------------------------------------------------------------
VITE_GOOGLE_CALENDAR_MODE=mock
# GOOGLE_CALENDAR_ACCESS_TOKEN=
# GOOGLE_CALENDAR_ID=primary

# ---------------------------------------------------------------------------
# Google Drive — recently modified files relevant to active projects.
# Not yet wired to live data — needs a server-side proxy (see README).
# ---------------------------------------------------------------------------
VITE_GOOGLE_DRIVE_MODE=mock
# GOOGLE_DRIVE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Gmail — flags client/business threads needing a reply. Only subject,
# sender, and snippet are ever read — never full message bodies.
# Not yet wired to live data — needs a server-side proxy (see README).
# ---------------------------------------------------------------------------
VITE_GMAIL_MODE=mock
# GMAIL_ACCESS_TOKEN=
