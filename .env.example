# Maple & Pine Command Center — environment configuration
#
# The dashboard runs with zero configuration using realistic mock data.
# To wire up a real source, set its MODE to "live" and provide the
# credentials below. Every source is independent — you can flip one to
# live while leaving the others on mock.
#
# Copy this file to .env.local and fill in values. Never commit real
# credentials.

# ---------------------------------------------------------------------------
# Notion (OmniStack) — primary source of truth for tasks, project/release
# status, and AI-agent activity logs.
# ---------------------------------------------------------------------------
VITE_NOTION_MODE=mock
# Internal integration token from https://www.notion.so/my-integrations
VITE_NOTION_API_KEY=
# Database ID for the tasks database (share it with your integration first)
VITE_NOTION_TASKS_DB_ID=
# Database ID for the projects/release-status database
VITE_NOTION_PROJECTS_DB_ID=
# Database ID for the release & ritual calendar database
VITE_NOTION_CALENDAR_DB_ID=
# Database ID for the AI agent activity log database
VITE_NOTION_AGENTS_DB_ID=

# ---------------------------------------------------------------------------
# Google Calendar — today's scheduled events/deadlines.
# ---------------------------------------------------------------------------
VITE_GOOGLE_CALENDAR_MODE=mock
# OAuth2 access token with https://www.googleapis.com/auth/calendar.readonly
VITE_GOOGLE_CALENDAR_ACCESS_TOKEN=
# Calendar ID to read from (use "primary" for the account's main calendar)
VITE_GOOGLE_CALENDAR_ID=primary

# ---------------------------------------------------------------------------
# Google Drive — recently modified files relevant to active projects.
# ---------------------------------------------------------------------------
VITE_GOOGLE_DRIVE_MODE=mock
# OAuth2 access token with https://www.googleapis.com/auth/drive.readonly
VITE_GOOGLE_DRIVE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Gmail — flags client/business threads needing a reply. Only subject,
# sender, and snippet are ever read — never full message bodies.
# ---------------------------------------------------------------------------
VITE_GMAIL_MODE=mock
# OAuth2 access token with https://www.googleapis.com/auth/gmail.readonly
VITE_GMAIL_ACCESS_TOKEN=
