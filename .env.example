# ---------------------------------------------------------------------------
# Maple & Pine Command Center — environment variables
# Copy this file to .env (or .env.local) and fill in the values below.
# NOTION_* variables are server-only and are NEVER sent to the browser.
# NEXT_PUBLIC_* variables are safe to expose and control client behavior.
# ---------------------------------------------------------------------------

# 1. Notion internal integration token. Create one at
#    https://www.notion.so/my-integrations -> "New integration".
#    Copy the "Internal Integration Secret" (starts with "ntn_" or "secret_").
NOTION_TOKEN=ntn_your_internal_integration_secret_here

# 2. Required — Projects & Release Status database ID.
#    Powers the Project & Release Status Board and the Entity Overview Strip.
#    Expected properties: Name (title), Entity (select), Status
#    (status/select), Phase (select or text, optional), % Complete
#    (number, optional), Owner (person or text, optional), Next Milestone
#    (date, optional).
NOTION_PROJECTS_DATABASE_ID=your_projects_database_id_here

# 3. Required — Release Calendar database ID.
#    Powers the Release Calendar panel and feeds upcoming-deadline data into
#    the Entity Overview Strip.
#    Expected properties: Name (title), Entity (select), Date (date),
#    Type (select, optional — e.g. "Release", "Launch", "Key Date").
NOTION_CALENDAR_DATABASE_ID=your_release_calendar_database_id_here

# 4. Optional — Financials database ID.
#    Powers the Revenue & Financials panel. Leave unset to show a graceful
#    "No financial data connected" empty state instead of an error.
#    Expected properties: Entity (title or select), Revenue (number),
#    Period (date or text, optional), Currency (text or select, optional —
#    defaults to USD).
NOTION_FINANCIALS_DATABASE_ID=

# 5. Optional — Team & AI-Agent Activity database ID.
#    Powers the Team & AI-Agent Activity panel for Chad, Claude, Dispatch,
#    Codey, Gem, Manus, and Main AI Brain. Leave unset to show a schema
#    placeholder instead of an error.
#    Expected properties: Name (title), Role (text or select, optional),
#    Status (status/select, optional), Current Assignment (text, optional),
#    Entity (select, optional).
NOTION_TEAM_DATABASE_ID=

# 6. Optional — auto-refresh interval in milliseconds. Defaults to 300000
#    (5 minutes) if unset. Minimum enforced value is 30000 (30 seconds).
#    This is a NEXT_PUBLIC_ variable because the browser owns the polling
#    timer — it never carries any secret.
NEXT_PUBLIC_REFRESH_INTERVAL_MS=300000

# 7. Optional — Quick Actions / footer links, as a JSON array of
#    {"label": "...", "url": "..."} objects. Point these at your OmniStack
#    root and entity hub pages in Notion.
#    Example:
#    NEXT_PUBLIC_QUICK_LINKS=[{"label":"OmniStack Root","url":"https://notion.so/your-omnistack-root"},{"label":"WiseMinds Studios Hub","url":"https://notion.so/your-wiseminds-hub"}]
NEXT_PUBLIC_QUICK_LINKS=[]
